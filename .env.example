# ─── Supabase — projeto RedacaoCruzVermelha-Rj (ref: wlbbfkudeibalkaqphpo) ───
# Copie este arquivo para .env.local e preencha a service role key.
#   cp .env.example .env.local

# Client (browser + server components). Valores públicos: vão para o bundle.
NEXT_PUBLIC_SUPABASE_URL=https://wlbbfkudeibalkaqphpo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_LA0yYrCep1il3dHTsumHuQ_Q4WVftBm

# Fallback legado, usado por lib/supabase/{client,server}.ts e proxy.ts
# quando PUBLISHABLE_KEY não está definida. Opcional.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin (lib/supabase/admin.ts — server-only, ignora RLS).
# SEGREDO: nunca commitar, nunca prefixar com NEXT_PUBLIC_.
# Pegue em: Dashboard → Project Settings → API Keys → service_role
SUPABASE_URL=https://wlbbfkudeibalkaqphpo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Publicação no site institucional (FTP da Hostinger) ───
# Grava os artigos publicados em cruzvermelhariodejaneiro.org/noticias/.
# SEGREDO: FTP_PASSWORD nunca pode ganhar o prefixo NEXT_PUBLIC_ — isso
# entregaria a senha de escrita do site a qualquer visitante.
#
# Use a conta FTP limitada à pasta /public_html/noticias, nunca a conta
# principal: assim o pior caso possível é quebrar a seção de notícias.
FTP_HOST=45.152.46.153
# O usuário é o que o painel mostrar depois de criar a conta — costuma vir com
# o prefixo da hospedagem, no formato u448697994.<nome>.
FTP_USER=
FTP_PASSWORD=
# Pasta de trabalho dentro do que a conta de FTP enxerga.
#
# Com a conta limitada a .../public_html/noticias no painel da Hostinger, ela já
# entra confinada e o valor certo é "/" — apontar para /noticias aqui criaria
# noticias/noticias. Só use /noticias se a conta abrir na raiz do site.
#
# Na dúvida, /api/admin/ftp-check mostra a listagem da pasta em que entrou:
# se aparecer index.html, a conta está na raiz e este valor precisa ser
# /noticias. De todo jeito, caminho que tente sair desta pasta é recusado.
FTP_BASE_DIR=/

# Endereço público correspondente à pasta acima. O diagnóstico grava um arquivo
# por FTP e busca este endereço para provar que a pasta é mesmo publicada — é
# daqui que sai o link do artigo e a URL da imagem que o Instagram baixa.
SITE_PUBLIC_BASE_URL=https://cruzvermelhariodejaneiro.org/noticias

# Afrouxa a verificação do certificado TLS. Necessário enquanto FTP_HOST for um
# endereço IP, porque certificado não casa com IP. A sessão segue cifrada, mas
# deixa de provar a identidade do servidor. Ative o hostname na Hostinger e
# remova esta variável quando puder.
# FTP_TLS_INSECURE=1

# --- Publicação nas redes sociais (Upload-Post) ---------------------------
# Publica no Facebook, Instagram, LinkedIn, X e Threads sem precisar de um app
# próprio aprovado pela Meta: o OAuth roda contra o app já aprovado do
# Upload-Post. Gere a chave em https://app.upload-post.com/api-keys.
# Nunca prefixe com NEXT_PUBLIC_ — a chave publica em nome da instituição e
# variáveis com esse prefixo vão para o navegador de todo visitante.
UPLOAD_POST_API_KEY=

# Nome do perfil no Upload-Post onde ficam as contas conectadas. Precisa ser
# EXATAMENTE o nome que aparece em app.upload-post.com/manage-users — um nome
# que não existe faria a Redação publicar num perfil vazio, sem erro visível.
# /api/admin/redes-check lista os nomes exatos da conta.
UPLOAD_POST_PROFILE=

# Id da página do Facebook de destino. Descubra em /api/admin/redes-check
# depois de conectar a conta.
UPLOAD_POST_FACEBOOK_PAGE_ID=
