# ---------------------------------------------------------------------------
# Publicação em redes sociais (Meta) — variáveis novas
# Configure todas na Vercel: Project → Settings → Environment Variables
# ---------------------------------------------------------------------------

# App da Meta (developers.facebook.com → seu app → Configurações → Básico)
META_APP_ID=
META_APP_SECRET=

# URL pública do site, sem barra no final.
# Usada no callback do OAuth e nas URLs de mídia que a Meta vai baixar.
NEXT_PUBLIC_SITE_URL=https://redacao.cvrj.org.br

# Cifragem dos tokens de acesso guardados no banco.
# Gere com: openssl rand -base64 32
SOCIAL_ENCRYPTION_KEY=

# Assinatura das URLs temporárias de mídia.
# Gere com: openssl rand -base64 32
SOCIAL_MEDIA_SIGNING_KEY=

# Segredo compartilhado entre o pg_cron do Supabase e a rota /api/social/worker.
# Precisa ser o MESMO valor colocado no bloco pg_cron da migração 0001.
# Gere com: openssl rand -hex 32
SOCIAL_WORKER_SECRET=

# ---------------------------------------------------------------------------
# Já existentes no projeto (apenas para referência)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# BLOB_READ_WRITE_TOKEN=
